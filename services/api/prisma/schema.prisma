datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
  schemas   = ["public", "auth"]
}

generator client {
  provider        = "prisma-client-js"
  previewFeatures = ["multiSchema"]
}

model User {
  id         String       @id @db.Uuid
  email      String?
  createdAt  DateTime?    @default(now()) @map("created_at") @db.Timestamp(6)
  profile    Profile?
  properties Property[]
  favorites  Favorite[]
  reviews    Review[]
  visits     Visit[]
  reports    Report[]
  auditLogs  AuditLog[]

  @@map("users")
  @@schema("auth")
}

model Profile {
  id        String    @id @db.Uuid
  firstName String?   @map("first_name") @db.VarChar(100)
  lastName  String?   @map("last_name") @db.VarChar(100)
  phone     String?   @db.VarChar(20)
  avatarUrl String?   @map("avatar_url")
  role      String?   @default("user") @db.VarChar(20)
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt DateTime? @default(now()) @map("updated_at") @db.Timestamp(6)

  user      User      @relation(fields: [id], references: [id], onDelete: Cascade)

  @@map("profiles")
  @@schema("public")
}

model Location {
  id        String     @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  name      String     @db.VarChar(150)
  type      String     @db.VarChar(30)
  parentId  String?    @map("parent_id") @db.Uuid
  createdAt DateTime?  @default(now()) @map("created_at") @db.Timestamp(6)

  parent     Location?  @relation("LocationHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children   Location[] @relation("LocationHierarchy")
  properties Property[]

  @@map("locations")
  @@schema("public")
}

model Property {
  id           String          @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  ownerId      String          @map("owner_id") @db.Uuid
  locationId   String          @map("location_id") @db.Uuid
  title        String          @db.VarChar(200)
  description  String?
  propertyType String?         @map("property_type") @db.VarChar(50)
  listingType  String?         @map("listing_type") @db.VarChar(20)
  price        Decimal?        @db.Decimal(12, 2)
  bedrooms     Int?            @default(0)
  bathrooms    Int?            @default(0)
  area         Decimal?        @db.Decimal(10, 2)
  address      String?
  status       String?         @default("pending") @db.VarChar(30)
  createdAt    DateTime?       @default(now()) @map("created_at") @db.Timestamp(6)
  updatedAt    DateTime?       @default(now()) @map("updated_at") @db.Timestamp(6)

  owner        User            @relation(fields: [ownerId], references: [id], onDelete: Cascade)
  location     Location        @relation(fields: [locationId], references: [id])
  images       PropertyImage[]
  favorites    Favorite[]
  reviews      Review[]
  visits       Visit[]
  reports      Report[]

  @@map("properties")
  @@schema("public")
}

model PropertyImage {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  propertyId String?   @map("property_id") @db.Uuid
  imageUrl   String    @map("image_url")
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("property_images")
  @@schema("public")
}

model Favorite {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  propertyId String?   @map("property_id") @db.Uuid
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@unique([userId, propertyId])
  @@map("favorites")
  @@schema("public")
}

model Review {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  propertyId String?   @map("property_id") @db.Uuid
  rating     Int?
  comment    String?
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("reviews")
  @@schema("public")
}

model Visit {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  propertyId String?   @map("property_id") @db.Uuid
  visitDate  DateTime? @map("visit_date") @db.Timestamp(6)
  status     String?   @default("requested") @db.VarChar(30)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("visits")
  @@schema("public")
}

model Report {
  id         String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId     String?   @map("user_id") @db.Uuid
  propertyId String?   @map("property_id") @db.Uuid
  reason     String
  status     String?   @default("open") @db.VarChar(30)
  createdAt  DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  user       User?     @relation(fields: [userId], references: [id], onDelete: Cascade)
  property   Property? @relation(fields: [propertyId], references: [id], onDelete: Cascade)

  @@map("reports")
  @@schema("public")
}

model AuditLog {
  id        String    @id @default(dbgenerated("uuid_generate_v4()")) @db.Uuid
  userId    String?   @map("user_id") @db.Uuid
  action    String
  tableName String?   @map("table_name")
  recordId  String?   @map("record_id") @db.Uuid
  createdAt DateTime? @default(now()) @map("created_at") @db.Timestamp(6)

  user      User?     @relation(fields: [userId], references: [id], onDelete: SetNull)

  @@map("audit_logs")
  @@schema("public")
}
