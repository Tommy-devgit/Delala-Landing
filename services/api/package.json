{
  "name": "delala-api-service",
  "version": "0.1.0",
  "description": "Enterprise NestJS REST API for Delala Platform",
  "scripts": {
    "build": "tsc",
    "format": "prettier --write \"src/**/*.ts\"",
    "start": "node dist/main",
    "start:dev": "npx nest start --watch",
    "start:debug": "nest start --debug --watch",
    "start:prod": "node dist/main",
    "prisma:generate": "prisma generate",
    "prisma:migrate": "ts-node prisma/add-contact-phone.ts && ts-node prisma/add-bio.ts && ts-node prisma/alter-avatar-url.ts && ts-node prisma/add-coordinates.ts && ts-node prisma/add-profile-status.ts && ts-node prisma/add-notifications.ts && ts-node prisma/add-password-hash.ts && ts-node prisma/add-property-features.ts && ts-node prisma/add-profile-verification.ts",
    "make-admin": "ts-node prisma/make-admin.ts",
    "set-password": "ts-node prisma/set-password.ts",
    "prisma:seed": "ts-node prisma/seed.ts"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "^3.1103.0",
    "@nestjs/common": "^10.4.15",
    "@nestjs/core": "^10.4.15",
    "@nestjs/jwt": "^10.2.0",
    "@nestjs/passport": "^10.0.3",
    "@nestjs/platform-express": "^10.4.15",
    "@nestjs/swagger": "^8.1.1",
    "@prisma/client": "^6.3.0",
    "@supabase/supabase-js": "^2.48.1",
    "@types/multer": "^2.2.0",
    "class-transformer": "^0.5.1",
    "class-validator": "^0.14.1",
    "passport": "^0.7.0",
    "passport-jwt": "^4.0.1",
    "reflect-metadata": "^0.2.2",
    "rxjs": "^7.8.1"
  },
  "devDependencies": {
    "@nestjs/cli": "^10.4.9",
    "@nestjs/schematics": "^10.2.3",
    "@nestjs/testing": "^10.4.15",
    "@types/express": "^5.0.0",
    "@types/node": "^22.13.1",
    "@types/passport-jwt": "^4.0.1",
    "prisma": "^6.3.0",
    "ts-node": "^10.9.2",
    "typescript": "^5.7.3"
  }
}
